# Public canonical site URL used by metadata and sitemap.
NEXT_PUBLIC_SITE_URL=https://www.radianceclinics.com

# Optional public API base URL. Leave blank until the PHP/MySQL API is live.
NEXT_PUBLIC_API_BASE_URL=

# Optional server-only Gemini key for the assistant route.
# If omitted, the assistant uses the built-in safe fallback responder.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_API_KEY=

# Optional Google reviews integration. Keep every credential server-side.
# Full Business Profile feed (preferred; requires approved GBP API access):
GOOGLE_BUSINESS_PROFILE_CLIENT_ID=
GOOGLE_BUSINESS_PROFILE_CLIENT_SECRET=
GOOGLE_BUSINESS_PROFILE_REFRESH_TOKEN=
GOOGLE_BUSINESS_PROFILE_ACCOUNT_ID=
GOOGLE_BUSINESS_PROFILE_LOCATION_ID=

# Public Places summary/review fallback:
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Optional direct clinic profile URL used by review links:
GOOGLE_BUSINESS_PROFILE_MAPS_URL=
